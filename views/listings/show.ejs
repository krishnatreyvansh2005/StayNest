<% layout("/layouts/boilerplate") %>

<style>
    .listing-detail {
        max-width: 1000px;
        margin: 2rem auto;
    }

    .listing-hero {
        width: 100%;
        height: 450px;
        object-fit: cover;
        border-radius: 1.25rem;
    }

    .listing-info {
        padding: 1.5rem 0;
    }

    .listing-title {
        font-size: 2rem;
        font-weight: 700;
        margin-bottom: 0.5rem;
    }

    .listing-location {
        color: #666;
        margin-bottom: 1.25rem;
    }

    .listing-description {
        line-height: 1.7;
        color: #444;
    }

    .price-box {
        background: #f8f8f8;
        border-radius: 1rem;
        padding: 1rem 1.25rem;
        margin: 1.25rem 0;
    }

    .price {
        font-size: 1.35rem;
        font-weight: 700;
    }

    .action-buttons {
        display: flex;
        gap: 0.75rem;
        margin-top: 1rem;
    }

    .review-section {
        margin-top: 2rem;
    }

    .review-card {
        border: 1px solid #e5e5e5;
        border-radius: 1rem;
        padding: 1rem;
        margin-bottom: 1rem;
        background: #fff;
    }

    .review-author {
        font-weight: 600;
        margin-bottom: 0.5rem;
    }

    .review-comment {
        color: #555;
        margin-bottom: 0.75rem;
    }

    .review-form {
        background: #f8f8f8;
        padding: 1.5rem;
        border-radius: 1rem;
        margin-bottom: 2rem;
    }

    @media (max-width: 768px) {
        .listing-detail {
            margin: 1rem auto;
        }

        .listing-hero {
            height: 300px;
            border-radius: 1rem;
        }

        .listing-title {
            font-size: 1.6rem;
        }
    }
</style>

<div class="container listing-detail">

    <% if (!listing) { %>

        <div class="alert alert-warning">
            Listing not found.
        </div>

    <% } else { %>

        <!-- Listing Image -->

        <img
            src="<%= listing.image.url %>"
            class="listing-hero"
            alt="<%= listing.title %>"
        >

        <!-- Listing Information -->

        <div class="listing-info">

            <h1 class="listing-title">
                <%= listing.title %>
            </h1>

            <p class="listing-location">
                <i class="fa-solid fa-location-dot"></i>
                <%= listing.location %>, <%= listing.country %>
            </p>

            <p>
                Hosted by
                <strong>
                    <%= listing.owner.username %>
                </strong>
            </p>

            <hr>

            <p class="listing-description">
                <%= listing.description %>
            </p>

            <div class="price-box">

                <span class="price">
                    &#8377;
                    <%= typeof listing.price === "number"
                        ? listing.price.toLocaleString("en-IN")
                        : "Price not available"
                    %>
                </span>

                <span> / night</span>

            </div>

            <!-- Owner Actions -->

            <% if (
                typeof currUser !== 'undefined' &&
                currUser &&
                listing.owner._id.equals(currUser._id)
            ) { %>

                <div class="action-buttons">

                    <a
                        href="/listings/<%= listing._id %>/edit"
                        class="btn btn-dark"
                    >
                        <i class="fa-solid fa-pen"></i>
                        Edit Listing
                    </a>

                    <form
                        method="POST"
                        action="/listings/<%= listing._id %>?_method=DELETE"
                    >

                        <button class="btn btn-outline-danger">
                            <i class="fa-solid fa-trash"></i>
                            Delete
                        </button>

                    </form>

                </div>

            <% } %>

        </div>

        <hr>

        <!-- Review Section -->

        <div class="review-section">

            <% if (typeof currUser !== 'undefined' && currUser) { %>

                <div class="review-form">

                    <h4>Share your experience</h4>

                    <p class="text-muted">
                        Tell other guests what you thought about this stay.
                    </p>

                    <form
                        action="/listings/<%= listing.id %>/reviews"
                        method="POST"
                        novalidate
                        class="needs-validation"
                    >

                        <div class="mb-3">

                            <label class="form-label">
                                Rating
                            </label>

                            <fieldset class="starability-slot">

                                <input
                                    type="radio"
                                    id="no-rate"
                                    class="input-no-rate"
                                    name="review[rating]"
                                    value="0"
                                    checked
                                    aria-label="No rating."
                                >

                                <input
                                    type="radio"
                                    id="first-rate1"
                                    name="review[rating]"
                                    value="1"
                                >
                                <label for="first-rate1" title="Terrible">
                                    1 star
                                </label>

                                <input
                                    type="radio"
                                    id="first-rate2"
                                    name="review[rating]"
                                    value="2"
                                >
                                <label for="first-rate2" title="Not good">
                                    2 stars
                                </label>

                                <input
                                    type="radio"
                                    id="first-rate3"
                                    name="review[rating]"
                                    value="3"
                                >
                                <label for="first-rate3" title="Average">
                                    3 stars
                                </label>

                                <input
                                    type="radio"
                                    id="first-rate4"
                                    name="review[rating]"
                                    value="4"
                                >
                                <label for="first-rate4" title="Very good">
                                    4 stars
                                </label>

                                <input
                                    type="radio"
                                    id="first-rate5"
                                    name="review[rating]"
                                    value="5"
                                >
                                <label for="first-rate5" title="Amazing">
                                    5 stars
                                </label>

                            </fieldset>

                        </div>

                        <div class="mb-3">

                            <label
                                for="comment"
                                class="form-label"
                            >
                                Your review
                            </label>

                            <textarea
                                name="review[comment]"
                                id="comment"
                                rows="4"
                                class="form-control"
                                placeholder="What did you like about this stay?"
                                required
                            ></textarea>

                            <div class="invalid-feedback">
                                Please add some comments for your review.
                            </div>

                        </div>

                        <button class="btn btn-dark">
                            Submit Review
                        </button>

                    </form>

                </div>

            <% } %>

            <!-- Existing Reviews -->

            <h4 class="mb-3">
                Guest Reviews
            </h4>

            <% if (listing.reviews && listing.reviews.length > 0) { %>

                <div class="row">

                    <% for (review of listing.reviews) { %>

                        <div class="col-md-6">

                            <div class="review-card">

                                <div class="review-author">
                                    @<%= review.author.username %>
                                </div>

                                <p
                                    class="starability-result"
                                    data-rating="<%= review.rating %>"
                                ></p>

                                <p class="review-comment">
                                    <%= review.comment %>
                                </p>

                                <form
                                    method="POST"
                                    action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
                                >

                                    <button class="btn btn-sm btn-outline-dark">
                                        Delete
                                    </button>

                                </form>

                            </div>

                        </div>

                    <% } %>

                </div>

            <% } else { %>

                <p class="text-muted">
                    No reviews yet. Be the first to share your experience.
                </p>

            <% } %>

        </div>

    <% } %>

</div>