<% layout("/layouts/boilerplate") %>

<style>
    .edit-page {
        max-width: 850px;
        margin: 40px auto 70px;
    }

    .edit-header {
        margin-bottom: 30px;
    }

    .edit-header h2 {
        font-weight: 700;
        margin-bottom: 8px;
    }

    .edit-header p {
        color: #6b7280;
        margin: 0;
    }

    .edit-card {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 18px;
        padding: 30px;
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.06);
    }

    .form-label {
        font-weight: 600;
        margin-bottom: 8px;
    }

    .form-control {
        border-radius: 10px;
        padding: 11px 13px;
        border: 1px solid #d1d5db;
    }

    .form-control:focus {
        border-color: #222;
        box-shadow: 0 0 0 2px rgba(0, 0, 0, 0.08);
    }

    textarea.form-control {
        min-height: 130px;
        resize: vertical;
    }

    .current-image-box {
        background: #f8f9fa;
        border-radius: 14px;
        padding: 15px;
        margin-bottom: 22px;
    }

    .current-image-box p {
        font-weight: 600;
        margin-bottom: 15px;
    }

    .image-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
        gap: 14px;
    }

    .image-card {
        position: relative;
        border-radius: 12px;
        overflow: hidden;
        aspect-ratio: 1 / 1;
        background: #eee;
        border: 1px solid #ddd;
    }

    .image-card img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .image-number {
        position: absolute;
        top: 8px;
        left: 8px;
        background: rgba(0, 0, 0, 0.7);
        color: white;
        font-size: 12px;
        padding: 4px 8px;
        border-radius: 20px;
    }

    .upload-box {
        border: 2px dashed #ddd;
        border-radius: 12px;
        padding: 15px;
        background: #fafafa;
    }

    .upload-note {
        font-size: 13px;
        color: #6b7280;
        margin-top: 7px;
    }

    .new-image-preview {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
        gap: 12px;
        margin-top: 15px;
    }

    .preview-item {
        position: relative;
        border-radius: 10px;
        overflow: hidden;
        aspect-ratio: 1 / 1;
        border: 1px solid #ddd;
    }

    .preview-item img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .preview-number {
        position: absolute;
        top: 7px;
        left: 7px;
        background: rgba(0, 0, 0, 0.7);
        color: white;
        font-size: 12px;
        padding: 3px 7px;
        border-radius: 20px;
    }

    .edit-btn {
        width: 100%;
        border: none;
        border-radius: 10px;
        padding: 12px;
        font-weight: 600;
        font-size: 16px;
        margin-top: 10px;
    }

    .edit-btn:hover {
        opacity: 0.9;
    }

    @media (max-width: 768px) {

        .edit-page {
            margin: 25px 15px 50px;
        }

        .edit-card {
            padding: 20px;
        }

        .image-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }
</style>

<div class="edit-page">

    <div class="edit-header">

        <h2>Edit your stay</h2>

        <p>
            Update your property details and keep your listing fresh.
        </p>

    </div>

    <div class="edit-card">

        <form
            method="POST"
            action="/listings/<%= listing._id %>?_method=PUT"
            novalidate
            class="needs-validation"
            enctype="multipart/form-data"
        >

            <!-- Title -->

            <div class="mb-4">

                <label for="title" class="form-label">
                    Listing title
                </label>

                <input
                    id="title"
                    name="listing[title]"
                    value="<%= listing.title %>"
                    type="text"
                    class="form-control"
                    placeholder="Give your stay a name"
                    required
                >

            </div>

            <!-- Description -->

            <div class="mb-4">

                <label for="description" class="form-label">
                    Description
                </label>

                <textarea
                    id="description"
                    name="listing[description]"
                    class="form-control"
                    placeholder="Tell guests what makes this place special..."
                    required
                ><%= listing.description %></textarea>

            </div>

            <!-- Existing Images -->

            <div class="current-image-box">

                <p>
                    Current listing photos
                </p>

                <% if (listing.images && listing.images.length > 0) { %>

                    <div class="image-grid">

                        <% listing.images.forEach((image, index) => { %>

                            <div class="image-card">

                                <img
                                    src="<%= image.url %>"
                                    alt="<%= listing.title %> photo <%= index + 1 %>"
                                >

                                <span class="image-number">
                                    <%= index + 1 %>
                                </span>

                            </div>

                        <% }) %>

                    </div>

                <% } else { %>

                    <p class="text-muted mb-0">
                        No photos uploaded yet.
                    </p>

                <% } %>

            </div>

            <!-- Add New Images -->

            <div class="mb-4">

                <label for="images" class="form-label">
                    Add more photos
                </label>

                <div class="upload-box">

                    <input
                        id="images"
                        name="listing[images]"
                        type="file"
                        class="form-control"
                        accept="image/png, image/jpeg, image/jpg"
                        multiple
                    >

                    <div class="upload-note">
                        You can add up to 10 photos at a time.
                    </div>

                    <div
                        id="newImagePreview"
                        class="new-image-preview"
                    ></div>

                </div>

            </div>

            <!-- Price + Country -->

            <div class="row">

                <div class="mb-4 col-md-4">

                    <label for="price" class="form-label">
                        Price per night
                    </label>

                    <input
                        id="price"
                        name="listing[price]"
                        value="<%= listing.price %>"
                        type="number"
                        class="form-control"
                        min="0"
                        required
                    >

                </div>

                <div class="mb-4 col-md-8">

                    <label for="country" class="form-label">
                        Country
                    </label>

                    <input
                        id="country"
                        name="listing[country]"
                        value="<%= listing.country %>"
                        type="text"
                        class="form-control"
                        required
                    >

                </div>

            </div>

            <!-- Location -->

            <div class="mb-4">

                <label for="location" class="form-label">
                    Location
                </label>

                <input
                    id="location"
                    name="listing[location]"
                    value="<%= listing.location %>"
                    type="text"
                    class="form-control"
                    placeholder="City, State"
                    required
                >

            </div>

            <!-- Submit -->

            <button
                type="submit"
                class="btn btn-dark edit-btn"
            >
                Save changes
            </button>

        </form>

    </div>

</div>

<script>

    const imageInput = document.getElementById("images");

    const imagePreview = document.getElementById("newImagePreview");

    imageInput.addEventListener("change", function () {

        imagePreview.innerHTML = "";

        const files = Array.from(this.files);

        if (files.length > 10) {

            alert("You can add a maximum of 10 photos at a time.");

            this.value = "";

            return;
        }

        files.forEach((file, index) => {

            const reader = new FileReader();

            reader.onload = function (event) {

                const previewItem = document.createElement("div");

                previewItem.className = "preview-item";

                previewItem.innerHTML = `
                    <img
                        src="${event.target.result}"
                        alt="New property photo ${index + 1}"
                    >

                    <span class="preview-number">
                        ${index + 1}
                    </span>
                `;

                imagePreview.appendChild(previewItem);

            };

            reader.readAsDataURL(file);

        });

    });

</script>

<script src="/js/script.js"></script>