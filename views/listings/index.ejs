<% layout("/layouts/boilerplate") %>

<style>
    .category-bar {
        display: flex;
        gap: 1.5rem;
        overflow-x: auto;
        padding: 1.25rem 0 0.75rem;
        scrollbar-width: none;
    }

    .category-bar::-webkit-scrollbar {
        display: none;
    }

    .category {
        min-width: 75px;
        text-align: center;
        opacity: 0.7;
        cursor: pointer;
        transition: 0.2s ease;
    }

    .category:hover {
        opacity: 1;
        transform: translateY(-2px);
    }

    .category i {
        font-size: 1.2rem;
        margin-bottom: 0.35rem;
    }

    .category p {
        margin: 0;
        font-size: 0.78rem;
        white-space: nowrap;
    }

    .tax-toggle {
        margin-left: auto;
        display: flex;
        align-items: center;
        white-space: nowrap;
        padding: 0.65rem 1rem;
        border: 1px solid #ddd;
        border-radius: 2rem;
        background: #fff;
    }

    .listing-card {
        border: none;
        margin-bottom: 2rem;
        transition: transform 0.2s ease;
    }

    .listing-card:hover {
        transform: translateY(-4px);
    }

    .listing-image {
        width: 100%;
        height: 20rem;
        object-fit: cover;
        border-radius: 1rem;
    }

    .listing-card .card-body {
        padding: 0.8rem 0.2rem;
    }

    .listing-title {
        font-size: 1rem;
        margin-bottom: 0.25rem;
    }

    .listing-price {
        color: #555;
        margin: 0;
    }

    .tax-info {
        display: none;
        color: #777;
    }

    .listing-link {
        text-decoration: none;
        color: inherit;
    }

    .listing-link:hover {
        color: inherit;
    }

    @media (max-width: 768px) {
        .tax-toggle {
            margin-left: 0;
        }

        .listing-image {
            height: 18rem;
        }
    }
</style>

<div class="category-bar">

    <div class="category">
        <i class="fa-solid fa-fire"></i>
        <p>Trending</p>
    </div>

    <div class="category">
        <i class="fa-solid fa-bed"></i>
        <p>Rooms</p>
    </div>

    <div class="category">
        <i class="fa-solid fa-city"></i>
        <p>City Stays</p>
    </div>

    <div class="category">
        <i class="fa-solid fa-mountain-sun"></i>
        <p>Mountain</p>
    </div>

    <div class="category">
        <i class="fa-solid fa-person-swimming"></i>
        <p>Pool</p>
    </div>

    <div class="category">
        <i class="fa-solid fa-campground"></i>
        <p>Camping</p>
    </div>

    <div class="category">
        <i class="fa-solid fa-house"></i>
        <p>Homes</p>
    </div>

    <div class="category">
        <i class="fa-solid fa-sailboat"></i>
        <p>Waterfront</p>
    </div>

    <div class="tax-toggle">
        <div class="form-check form-switch">
            <input
                class="form-check-input"
                type="checkbox"
                role="switch"
                id="taxSwitch"
            >
            <label class="form-check-label" for="taxSwitch">
                Show taxes
            </label>
        </div>
    </div>

</div>

<div class="row row-cols-lg-3 row-cols-md-2 row-cols-1 mt-3">

    <% if (allListings && allListings.length) { %>

        <% allListings.forEach(function(listing) { %>

            <div class="col">

                <a
                    href="/listings/<%= listing._id %>"
                    class="listing-link"
                >

                    <div class="card listing-card">

                        <img
                            src="<%= listing.image.url %>"
                            class="listing-image"
                            alt="<%= listing.title %>"
                        >

                        <div class="card-body">

                            <h5 class="listing-title">
                                <b><%= listing.title %></b>
                            </h5>

                            <p class="listing-price">

                                &#8377;
                                <%= listing.price
                                    ? listing.price.toLocaleString("en-IN")
                                    : "Price not available"
                                %>
                                / night

                                <span class="tax-info">
                                    &nbsp; +18% GST
                                </span>

                            </p>

                        </div>

                    </div>

                </a>

            </div>

        <% }); %>

    <% } else { %>

        <div class="col-12">
            <p class="text-muted">
                No stays available yet.
            </p>
        </div>

    <% } %>

</div>

<script>

    const taxSwitch = document.getElementById("taxSwitch");

    taxSwitch.addEventListener("change", () => {

        const taxInfo = document.querySelectorAll(".tax-info");

        taxInfo.forEach((info) => {

            info.style.display =
                taxSwitch.checked ? "inline" : "none";

        });

    });

</script>