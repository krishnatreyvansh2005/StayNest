<% layout("/layouts/boilerplate") %>

<style>
    .create-page {
        max-width: 850px;
        margin: 2rem auto;
    }

    .form-header {
        margin-bottom: 2rem;
    }

    .form-header h1 {
        font-weight: 700;
        margin-bottom: 0.5rem;
    }

    .form-header p {
        color: #6c757d;
    }

    .listing-form {
        background: #fff;
        border: 1px solid #e5e5e5;
        border-radius: 1.25rem;
        padding: 2rem;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
    }

    .form-label {
        font-weight: 600;
    }

    .form-control {
        border-radius: 0.7rem;
        padding: 0.7rem 0.85rem;
    }

    textarea.form-control {
        min-height: 130px;
        resize: vertical;
    }

    .price-input {
        position: relative;
    }

    .price-symbol {
        position: absolute;
        left: 0.9rem;
        top: 50%;
        transform: translateY(-50%);
        color: #666;
    }

    .price-input input {
        padding-left: 2rem;
    }

    .upload-box {
        border: 2px dashed #ddd;
        border-radius: 0.8rem;
        padding: 1rem;
        background: #fafafa;
    }

    .submit-btn {
        border-radius: 0.7rem;
        padding: 0.7rem 1.5rem;
        font-weight: 600;
    }
</style>

<div class="container create-page">

    <div class="form-header">
        <h1>Add a new stay</h1>
        <p>
            Share your property with travelers looking for their next stay.
        </p>
    </div>

    <form
        method="POST"
        action="/listings"
        novalidate
        class="needs-validation listing-form"
        enctype="multipart/form-data"
    >

        <!-- Title -->

        <div class="mb-4">

            <label for="title" class="form-label">
                Property title
            </label>

            <input
                id="title"
                name="listing[title]"
                placeholder="e.g. Cozy mountain cabin"
                type="text"
                class="form-control"
                required
            >

            <div class="invalid-feedback">
                Please enter a title for your property.
            </div>

        </div>

        <!-- Description -->

        <div class="mb-4">

            <label for="description" class="form-label">
                Description
            </label>

            <textarea
                id="description"
                name="listing[description]"
                class="form-control"
                placeholder="Tell guests what makes this place special..."
                required
            ></textarea>

            <div class="invalid-feedback">
                Please add a description.
            </div>

        </div>

        <!-- Image -->

        <div class="mb-4">

            <label for="image" class="form-label">
                Property image
            </label>

            <div class="upload-box">

                <input
                    id="image"
                    name="listing[image]"
                    type="file"
                    class="form-control"
                    accept="image/png, image/jpeg, image/jpg"
                    required
                >

                <small class="text-muted d-block mt-2">
                    JPG or PNG images are recommended.
                </small>

            </div>

            <div class="invalid-feedback">
                Please upload a property image.
            </div>

        </div>

        <!-- Price + Country -->

        <div class="row">

            <div class="mb-4 col-md-5">

                <label for="price" class="form-label">
                    Price per night
                </label>

                <div class="price-input">

                    <span class="price-symbol">
                        &#8377;
                    </span>

                    <input
                        id="price"
                        name="listing[price]"
                        placeholder="1200"
                        type="number"
                        min="1"
                        class="form-control"
                        required
                    >

                </div>

                <div class="invalid-feedback">
                    Please enter a valid price.
                </div>

            </div>

            <div class="mb-4 col-md-7">

                <label for="country" class="form-label">
                    Country
                </label>

                <input
                    id="country"
                    name="listing[country]"
                    placeholder="India"
                    type="text"
                    class="form-control"
                    required
                >

                <div class="invalid-feedback">
                    Please enter a valid country.
                </div>

            </div>

        </div>

        <!-- Location -->

        <div class="mb-4">

            <label for="location" class="form-label">
                Location
            </label>

            <input
                id="location"
                name="listing[location]"
                placeholder="e.g. Jaipur, Rajasthan"
                type="text"
                class="form-control"
                required
            >

            <div class="invalid-feedback">
                Please enter the property location.
            </div>

        </div>

        <button class="btn btn-dark submit-btn mt-2">
            <i class="fa-solid fa-plus"></i>
            Create Listing
        </button>

    </form>

</div>