<% layout("/layouts/boilerplate") %>

<style>
    .create-page {
        max-width: 850px;
        margin: 2rem auto;
    }

    .form-header {
        margin-bottom: 2rem;
    }

    .form-header h1 {
        font-weight: 700;
        margin-bottom: 0.5rem;
        color: #1F2937;
    }

    .form-header p {
        color: #6B7280;
    }

    .listing-form {
        background: #FFFFFF;
        border: 1px solid #E5E7EB;
        border-radius: 1.25rem;
        padding: 2rem;
        box-shadow: 0 6px 25px rgba(15, 118, 110, 0.06);
    }

    .form-label {
        font-weight: 600;
        color: #1F2937;
    }

    .form-control {
        border-radius: 0.7rem;
        padding: 0.7rem 0.85rem;
        border-color: #D1D5DB;
    }

    .form-control:focus {
        border-color: #0F766E;
        box-shadow: 0 0 0 0.2rem rgba(15, 118, 110, 0.12);
    }

    textarea.form-control {
        min-height: 130px;
        resize: vertical;
    }

    .price-input {
        position: relative;
    }

    .price-symbol {
        position: absolute;
        left: 0.9rem;
        top: 50%;
        transform: translateY(-50%);
        color: #0F766E;
        font-weight: 600;
    }

    .price-input input {
        padding-left: 2rem;
    }

    .upload-box {
        border: 2px dashed #99C7C3;
        border-radius: 0.8rem;
        padding: 1rem;
        background: #F7F7F2;
        transition: border-color 0.2s ease, background-color 0.2s ease;
    }

    .upload-box:hover {
        border-color: #0F766E;
        background: #F1F8F7;
    }

    .upload-box input {
        background: #FFFFFF;
    }

    .upload-help {
        color: #6B7280;
        font-size: 0.9rem;
    }

    .image-preview-container {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
        gap: 12px;
        margin-top: 1rem;
    }

    .preview-item {
        position: relative;
        border-radius: 0.75rem;
        overflow: hidden;
        aspect-ratio: 1 / 1;
        border: 1px solid #D1D5DB;
        background: #F7F7F2;
    }

    .preview-item img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .preview-number {
        position: absolute;
        top: 7px;
        left: 7px;
        background: #0F766E;
        color: white;
        font-size: 0.75rem;
        padding: 3px 7px;
        border-radius: 20px;
    }

    .submit-btn {
        border-radius: 0.7rem;
        padding: 0.7rem 1.5rem;
        font-weight: 600;
        background-color: #0F766E !important;
        border-color: #0F766E !important;
        color: #FFFFFF !important;
    }

    .submit-btn:hover {
        background-color: #115E59 !important;
        border-color: #115E59 !important;
    }
</style>

<div class="container create-page">

    <div class="form-header">
        <h1>Add a new stay</h1>

        <p>
            Share your property with travelers looking for their next stay.
        </p>
    </div>

    <form
        method="POST"
        action="/listings"
        novalidate
        class="needs-validation listing-form"
        enctype="multipart/form-data"
    >

        <!-- Title -->

        <div class="mb-4">

            <label for="title" class="form-label">
                Property title
            </label>

            <input
                id="title"
                name="listing[title]"
                placeholder="e.g. Cozy mountain cabin"
                type="text"
                class="form-control"
                required
            >

            <div class="invalid-feedback">
                Please enter a title for your property.
            </div>

        </div>

        <!-- Description -->

        <div class="mb-4">

            <label for="description" class="form-label">
                Description
            </label>

            <textarea
                id="description"
                name="listing[description]"
                class="form-control"
                placeholder="Tell guests what makes this place special..."
                required
            ></textarea>

            <div class="invalid-feedback">
                Please add a description.
            </div>

        </div>

        <!-- Images -->

        <div class="mb-4">

            <label for="images" class="form-label">
                Property photos
            </label>

            <div class="upload-box">

                <input
                    id="images"
                    name="listing[images]"
                    type="file"
                    class="form-control"
                    accept="image/png, image/jpeg, image/jpg"
                    multiple
                    required
                >

                <small class="upload-help d-block mt-2">
                    Upload up to 10 JPG or PNG photos.
                </small>

                <div
                    id="imagePreview"
                    class="image-preview-container"
                ></div>

            </div>

            <div class="invalid-feedback">
                Please upload at least one property photo.
            </div>

        </div>

        <!-- Price + Country -->

        <div class="row">

            <div class="mb-4 col-md-5">

                <label for="price" class="form-label">
                    Price per night
                </label>

                <div class="price-input">

                    <span class="price-symbol">
                        &#8377;
                    </span>

                    <input
                        id="price"
                        name="listing[price]"
                        placeholder="1200"
                        type="number"
                        min="1"
                        class="form-control"
                        required
                    >

                </div>

                <div class="invalid-feedback">
                    Please enter a valid price.
                </div>

            </div>

            <div class="mb-4 col-md-7">

                <label for="country" class="form-label">
                    Country
                </label>

                <input
                    id="country"
                    name="listing[country]"
                    placeholder="India"
                    type="text"
                    class="form-control"
                    required
                >

                <div class="invalid-feedback">
                    Please enter a valid country.
                </div>

            </div>

        </div>

        <!-- Location -->

        <div class="mb-4">

            <label for="location" class="form-label">
                Location
            </label>

            <input
                id="location"
                name="listing[location]"
                placeholder="e.g. Jaipur, Rajasthan"
                type="text"
                class="form-control"
                required
            >

            <div class="invalid-feedback">
                Please enter the property location.
            </div>

        </div>

        <button class="btn btn-dark submit-btn mt-2">

            <i class="fa-solid fa-plus"></i>

            Create Listing

        </button>

    </form>

</div>

<script>
    const imageInput = document.getElementById("images");
    const imagePreview = document.getElementById("imagePreview");

    imageInput.addEventListener("change", function () {

        imagePreview.innerHTML = "";

        const files = Array.from(this.files);

        if (files.length > 10) {
            alert("You can upload a maximum of 10 photos.");
            this.value = "";
            return;
        }

        files.forEach((file, index) => {

            const reader = new FileReader();

            reader.onload = function (event) {

                const previewItem = document.createElement("div");

                previewItem.className = "preview-item";

                previewItem.innerHTML = `
                    <img src="${event.target.result}" alt="Property photo ${index + 1}">
                    <span class="preview-number">
                        ${index + 1}
                    </span>
                `;

                imagePreview.appendChild(previewItem);
            };

            reader.readAsDataURL(file);
        });
    });
</script>